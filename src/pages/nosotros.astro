---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Image } from "astro:assets";

// Imágenes
import heroBg from '../assets/about1.png'; 
import meetingImg from '../assets/pagenosotros2.webp'; 
---

<Layout title="Sol de Palma | Nosotros">
  
  <main class="hero-container">
    <div class="bg-container">
      <Image src={heroBg} alt="Equipo Sol de Palma" class="hero-img" />
      <div class="overlay"></div>
    </div>
    <div class="content-wrapper">
      <Navbar />
      <section class="hero-text">
        <h1>El compromiso de construir un<br>futuro brillante para todos</h1>
      </section>
      <a href="#mision-vision" class="scroll-down">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9l-7 7l-7-7"/></svg>
      </a>
    </div>
  </main>

  <section id="mision-vision" class="mv-section">
    
    <div class="ambient-light"></div>

    <div class="container">
      <div class="mv-layout">
        
        <div class="image-column">
          <div class="img-frame">
            <Image src={meetingImg} alt="Reunión de equipo" class="mv-img" />
            <div class="orange-border"></div>
          </div>
        </div>

        <div class="cards-column">
          
          <div class="glass-card mission-card">
            <div class="card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5l10-5l-10-5zM2 17l10 5l10-5M2 12l10 5l10-5"/></svg>
            </div>
            <h3>MISIÓN</h3>
            <p>
              Transformamos el sector del aceite de palma en Perú a través de la innovación y la responsabilidad, recuperando tierras degradadas con un modelo sostenible.
            </p>
          </div>

          <div class="glass-card vision-card">
            <div class="card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <h3>VISIÓN</h3>
            <p>
              Convertirnos en la empresa peruana líder en el mercado del aceite de palma sostenible, creciendo junto a nuestros proveedores y consumidores de confianza.
            </p>
          </div>

        </div>

      </div>
    </div>
  </section>

  <Footer />

</Layout>

<style>
  /* --- HERO STYLES (Intactos) --- */
  .hero-container { position: relative; width: 100%; height: 80vh; overflow: hidden; }
  .bg-container { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
  .hero-img { width: 100%; height: 100%; object-fit: cover; object-position: center center; }
  .overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to bottom, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.6) 100%); z-index: 1; }
  .content-wrapper { position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; }
  .hero-text { flex-grow: 1; display: flex; justify-content: center; align-items: center; text-align: center; color: white; padding: 0 20px; }
  .hero-text h1 { font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 800; line-height: 1.2; text-shadow: 2px 2px 10px rgba(0,0,0,0.5); max-width: 900px; }
  .scroll-down { position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%); background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(5px); border: 1px solid rgba(255, 255, 255, 0.5); border-radius: 40%; color: white; width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; cursor: pointer; animation: bounce 2s infinite; }
  @keyframes bounce { 0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); } 40% { transform: translateX(-50%) translateY(-10px); } 60% { transform: translateX(-50%) translateY(-5px); } }

  /* --- NUEVO DISEÑO MISIÓN / VISIÓN --- */
  .mv-section {
    padding: 120px 20px;
    background-color: #f9f9f9; /* Fondo muy suave */
    position: relative;
    overflow: hidden;
  }

  /* Luz Ambiental (Orange Orb) */
  .ambient-light {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(255, 137, 5, 0.15) 0%, transparent 70%);
    z-index: 0;
    pointer-events: none;
  }

  .container { max-width: 1200px; margin: 0 auto; position: relative; z-index: 2; }

  .mv-layout {
    display: grid;
    grid-template-columns: 1fr 1fr; /* Mitad Imagen, Mitad Tarjetas */
    gap: 60px;
    align-items: center;
  }

  /* --- COLUMNA IMAGEN --- */
  .image-column {
    position: relative;
  }

  .img-frame {
    position: relative;
    width: 100%;
    height: 600px; /* Imagen Alta y Elegante */
    border-radius: 100px 20px 100px 20px; /* Forma orgánica */
    overflow: visible; /* Para que se vea el borde */
  }

  .mv-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 100px 20px 100px 20px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    position: relative;
    z-index: 2;
  }

  /* Borde Decorativo Desplazado */
  .orange-border {
    position: absolute;
    top: 20px;
    left: -20px; /* Desplazado a la izquierda */
    width: 100%;
    height: 100%;
    border: 3px solid #ff8905;
    border-radius: 100px 20px 100px 20px;
    z-index: 1;
    opacity: 0.6;
  }

  /* --- COLUMNA TARJETAS (CASCADA) --- */
  .cards-column {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .glass-card {
    background: rgba(255, 255, 255, 0.65); /* Blanco Lechoso */
    backdrop-filter: blur(20px); /* Desenfoque fuerte */
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    padding: 40px;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }
  
  /* Efecto de borde brillante al hover */
  .glass-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 4px; height: 100%;
    background: #ff8905;
    transform: scaleY(0);
    transition: transform 0.4s ease;
  }

  .glass-card:hover {
    transform: translateX(-10px) translateY(-5px); /* Se levanta y mueve un poco */
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 20px 50px rgba(255, 137, 5, 0.15); /* Sombra naranja suave */
  }

  .glass-card:hover::before {
    transform: scaleY(1);
  }

  /* Desplazamos la segunda tarjeta para romper la simetría */
  .vision-card {
    margin-left: 50px; /* Indentación visual */
  }

  /* Iconos */
  .card-icon {
    width: 50px;
    height: 50px;
    background: rgba(255, 137, 5, 0.1);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    color: #ff8905;
    margin-bottom: 20px;
  }

  h3 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #333;
    margin-bottom: 15px;
    letter-spacing: 1px;
  }

  p {
    color: #555;
    line-height: 1.6;
    font-size: 1rem;
  }

  /* --- RESPONSIVE --- */
  @media (max-width: 900px) {
    .mv-layout {
      grid-template-columns: 1fr;
    }

    .image-column {
      order: 1;
    }
    
    .img-frame { height: 400px; }

    .cards-column {
      order: 2;
    }

    .vision-card {
      margin-left: 0; /* Quitar indentación en móvil */
    }
  }
</style>