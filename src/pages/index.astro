---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import videoFondo from '../assets/videoFondo.mp4';
import posterImg from '../assets/logo_soldepalma.webp';
---

<Layout title="Sol de Palma | Inicio">
	
	<main class="hero-container">
		
		<video 
			class="video-bg" 
			autoplay 
			muted 
			loop 
			playsinline
			poster={posterImg.src}
		>
			<source src={videoFondo} type="video/mp4" />
		</video>

		<div class="overlay"></div>

		<div class="content-wrapper">
			<Navbar />
			
			<section class="hero-text">
				<h1>CULTIVANDO EL FUTURO</h1>
				<p>Palma Orgánica y Sostenible</p>
			</section>

			<a href="#siguiente-seccion" class="scroll-down" aria-label="Bajar a la siguiente sección">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
					<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9l-7 7l-7-7"/>
				</svg>
			</a>

		</div>
	</main>

	<section id="siguiente-seccion" class="next-section">
		<h2>Sección Nosotros</h2>
		<p>Aquí comienza el contenido del sitio web...</p>
	</section>

</Layout>

<style>
	/* --- TUS ESTILOS ANTERIORES (HERO) --- */
	.hero-container {
		position: relative;
		width: 100%;
		height: 100vh;
		overflow: hidden;
	}
	.video-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 1;
	}
	.overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.4);
		z-index: 2;
	}
	.content-wrapper {
		position: relative;
		z-index: 3;
		height: 100%;
		display: flex;
		flex-direction: column;
	}
	.hero-text {
		flex-grow: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		color: white;
		padding: 0 20px;
	}
	.hero-text h1 {
		font-size: clamp(2rem, 5vw, 4rem);
		font-weight: 800;
		margin-bottom: 1rem;
		text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
	}
	.hero-text p {
		font-size: clamp(1rem, 2vw, 1.5rem);
		font-weight: 300;
	}

	/* --- NUEVOS ESTILOS DEL BOTÓN SCROLL --- */
	.scroll-down {
		position: absolute;
		bottom: 40px; /* Separación del borde inferior */
		left: 50%;
		transform: translateX(-50%); /* Centrado perfecto */
		
		/* Estilo Glassmorphism (Igual que el nav/idioma) */
		background: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(5px);
		border: 1px solid rgba(255, 255, 255, 0.5);
		border-radius: 50%;
		
		color: white;
		width: 50px;
		height: 50px;
		display: flex;
		align-items: center;
		justify-content: center;
		
		cursor: pointer;
		transition: all 0.3s ease;
		
		/* Animación de Rebote */
		animation: bounce 2s infinite;
	}

	.scroll-down:hover {
		background: rgba(255, 255, 255, 0.3);
		border-color: white;
	}

	.scroll-down svg {
		width: 28px;
		height: 28px;
	}

	/* Definición de la animación Bounce */
	@keyframes bounce {
		0%, 20%, 50%, 80%, 100% {
			transform: translateX(-50%) translateY(0);
		}
		40% {
			transform: translateX(-50%) translateY(-10px);
		}
		60% {
			transform: translateX(-50%) translateY(-5px);
		}
	}

	/* Estilo temporal para la siguiente sección */
	.next-section {
		height: 100vh;
		background-color: #f4f4f4;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		color: #333;
	}
</style>