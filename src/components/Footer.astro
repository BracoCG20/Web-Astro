---
import { Image } from "astro:assets";
// Usaremos la misma imagen de fondo oscuro que en Sostenibilidad para mantener consistencia
import footerBg from '../assets/footerbackground.png'; 
---

<footer class="footer-section">
  
  <div class="bg-container">
    <Image src={footerBg} alt="Fondo Footer" class="footer-img" />
    <div class="dark-overlay"></div>
  </div>

  <div class="container">
    
    <div class="glass-card dark-mode">
      
      <div class="footer-grid">
        
        <div class="col-info">
          <h3 class="footer-title">Ubicación y Contacto</h3>
          
          <div class="info-item">
            <span class="label">Dirección:</span>
            <p>Av. Reducto 1363, Intr. 201,<br>Miraflores, Lima, Perú</p>
          </div>

          <div class="info-item">
            <span class="label">Razón Social:</span>
            <p>SOL DE PALMA S.A.</p>
          </div>

          <a href="mailto:contacto@soldepalma.com" class="email-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            contacto@soldepalma.com
          </a>
        </div>

        <div class="col-phones">
          <div class="phone-list">
            <a href="tel:+51947333400" class="phone-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +51 947 333 400
            </a>
            <a href="tel:+51919458623" class="phone-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +51 919 458 623
            </a>
          </div>
        </div>

        <div class="col-cta">
          <a href="/contacto" class="cta-button solid-orange">Enviar Mensaje</a>
        </div>

      </div>

      <div class="footer-bottom">
        <h2>Let's grow together!</h2>
      </div>

    </div>
  </div>
</footer>

<style>
  /* --- ESTRUCTURA GENERAL --- */
  .footer-section {
    position: relative;
    padding: 80px 20px;
    font-family: 'Nunito', sans-serif;
    color: white;
    margin-top: -20px; /* Para asegurar que cubra bien si hay espacios */
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* --- FONDO --- */
  .bg-container {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 0;
    background-color: #1a1816;
  }

  .footer-img {
    width: 100%; height: 100%; object-fit: cover;
    opacity: 0.4; /* Imagen sutil */
  }

  .dark-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    /* Degradado para que se funda con la sección anterior */
    background: linear-gradient(to bottom, #1a1816 0%, rgba(26, 24, 22, 0.8) 100%);
  }

  /* --- TARJETA GLASSMORPHISM OSCURA --- */
  .glass-card {
    background: rgba(30, 30, 30, 0.6);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 30px;
    padding: 60px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  }

  /* --- GRID LAYOUT --- */
  .footer-grid {
    display: grid;
    /* 3 Columnas: Info (flexible) | Teléfonos (auto) | Botón (auto) */
    grid-template-columns: 1.2fr auto auto;
    gap: 60px;
    align-items: center; /* Centrado verticalmente como en tu imagen */
    margin-bottom: 50px;
  }

  /* --- COLUMNA 1: INFO --- */
  .footer-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: white;
    margin-bottom: 25px;
  }

  .info-item {
    margin-bottom: 15px;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #e0e0e0;
  }

  .label {
    font-weight: 700;
    color: white;
  }

  .email-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #e0e0e0;
    text-decoration: none;
    margin-top: 15px;
    transition: color 0.3s;
  }
  
  .email-link:hover { color: #ff8905; }

  /* --- COLUMNA 2: TELÉFONOS --- */
  .col-phones {
    /* Las líneas horizontales arriba y abajo del bloque de teléfonos */
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    padding: 20px 0;
    width: 100%;
  }

  .phone-list {
    display: flex;
    flex-direction: column; /* Uno debajo del otro */
    gap: 15px;
  }

  .phone-item {
    display: flex;
    align-items: center;
    gap: 12px;
    color: white;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.3s ease;
  }

  .phone-item:hover { color: #ff8905; }

  /* --- COLUMNA 3: BOTÓN --- */
  .cta-button {
    display: inline-block;
    padding: 12px 35px;
    border-radius: 8px; /* Botón ligeramente cuadrado como en la imagen */
    font-weight: 700;
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    white-space: nowrap;
    text-align: center;
  }

  .solid-orange {
    background-color: #ff8905;
    color: white;
    border: none;
    box-shadow: 0 5px 15px rgba(255, 137, 5, 0.3);
  }

  .solid-orange:hover {
    background-color: #e07800;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 137, 5, 0.5);
  }

  /* --- SLOGAN FINAL --- */
  .footer-bottom {
    text-align: center;
    margin-top: 20px;
  }

  .footer-bottom h2 {
    font-size: 2.5rem;
    font-weight: 800;
    color: white;
    margin: 0;
    letter-spacing: 1px;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }

  /* --- RESPONSIVE --- */
  @media (max-width: 900px) {
    .glass-card { padding: 40px 25px; }

    .footer-grid {
      grid-template-columns: 1fr; /* Una columna */
      gap: 40px;
      text-align: center;
    }

    .info-item p, .email-link {
      justify-content: center;
    }

    /* En móvil, los teléfonos se ven mejor centrados */
    .col-phones {
      width: 100%;
      border-left: none; border-right: none;
      display: flex;
      justify-content: center;
    }

    .phone-item { justify-content: center; }

    .footer-bottom h2 { font-size: 2rem; }
  }
</style>